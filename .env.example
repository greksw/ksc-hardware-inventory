# Documentation only. The CLI reads KSC_* environment variables, not this file.
# Never commit a filled-in configuration, private devices, credentials or trust anchors.
KSC_URL=https://ksc.example.test:13299
KSC_CA_FILE=/home/operator/.config/ksc-hardware-inventory/ksc-ca.pem
KSC_USER=ksc-inventory-user
KSC_TARGET_FQDN=pc-demo-01.example.test
KSC_EXPECTED_COMPUTER=PC-DEMO-01
KSC_EXPECTED_GUID=YOUR_APPROVED_HOST_GUID
# SSH options are passed explicitly when --send is requested.
# --ssh-destination inventory-ingest@inventory.example.test
# --identity /home/operator/.ssh/inventory_ingest_ed25519
